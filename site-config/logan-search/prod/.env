NEXT_PUBLIC_ENVIRONMENT=prod
# Empty: requests go same-origin to /api/v1, which nginx proxies to the BRC
# backend for this host.
NEXT_PUBLIC_BACKEND_URL=
# No NEXT_PUBLIC_PLAUSIBLE_DOMAIN yet, and the shared _document refuses a prod
# build without one. That's deliberate for now: there is no prod deploy of this
# site until the hostname and analytics are decided.
