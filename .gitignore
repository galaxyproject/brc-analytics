# images
/sites/ga2/public/organism_image/*
!/sites/ga2/public/organism_image/missing_image*

# dependencies
/node_modules

# next.js
.next/
next-env.d.ts

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# env files
.env*.local
/.env.development
/.env.production
/sites/*/.env*
backend/**/.env

# typescript
*.tsbuildinfo

# swc plugin cache
.swc/

# editors
/.vscode
.idea

# favicons
/sites/ga2/public/favicons/*
/sites/brc-analytics/public/favicons/*

# catalog build
/catalog/build/temp
/catalog/ga2/build/temp

# Build Dir
out/

# root-level generated assets — each app builds under sites/*, so a public/ at
# the repo root is a leftover and must never be committed
/public

# Playwright test artifacts
test-results/
/tests/screenshots
/playwright/.cache
playwright-report/

# Playwright MCP server debug output
/.playwright-mcp/

# python
venv
__pycache__

# public api
/sites/ga2/public/api
/sites/brc-analytics/public/api

# Sentry Config File
.env.sentry-build-plugin

# Claude
.claude/rules*

# SRA mirror build artifacts (backend/api/scripts/build_sra_mirror.py).
# The taxdump is ~535MB of .dmp files and the mirror itself is ~10GB; both
# land next to wherever the script is run from.
taxdump/
*.dmp
*.duckdb
*.duckdb.new
